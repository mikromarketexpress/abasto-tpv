{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🚀 Dev — Iniciar Vite",
      "type": "shell",
      "command": "npm run dev",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE",
          "endsPattern": "ready in"
        }
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    },
    {
      "label": "📦 Build — Producción",
      "type": "shell",
      "command": "npm run build",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "👁️ Preview — Vista Previa",
      "type": "shell",
      "command": "npm run preview",
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "⬆️ PM2 — Iniciar Servicio",
      "type": "shell",
      "command": "npm run start",
      "group": "none",
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "⬇️ PM2 — Detener Servicio",
      "type": "shell",
      "command": "npm run stop",
      "group": "none",
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "🤖 OpenCode — Iniciar Web",
      "type": "shell",
      "command": "opencode web --port 4096 --hostname 127.0.0.1 && code --command \"workbench.action.experimental.simpleBrowser.show\" \"http://127.0.0.1:4096\"",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    },
    {
      "label": "📥 Install — Instalar dependencias",
      "type": "shell",
      "command": "npm install",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}
