# ============================================================================
# MICRO MARKET EXPRESS — Plantilla de Variables de Entorno
# Copia este archivo como .env y completa los valores
# ============================================================================

# ─── OpenCode AI ──────────────────────────────────────────────────────────────
OPENCODE_AI_PROVIDER="ollama"
OPENCODE_MODEL="qwen2.5-coder:7b"
OLLAMA_BASE_URL="http://localhost:11434"

# ─── Vite (variables públicas, prefijo VITE_) ────────────────────────────────
VITE_GS_WEBAPP_URL=https://script.google.com/macros/s/TU_WEB_APP_ID/exec
VITE_GS_DRIVE_FOLDER_ID=TU_DRIVE_FOLDER_ID
VITE_GS_SPREADSHEET_ID=TU_SPREADSHEET_ID

# ─── Desarrollo ──────────────────────────────────────────────────────────────
VITE_APP_ENV=development
